# ==============================================================================
# FixMate Environment Variables Template (.env.example)
# Copy this file to .env.local and populate the values below.
# Note: Keep DATABASE_URL strictly server-side. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# Supabase PostgreSQL Connection String
# Retrieve from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Mode: Transaction Pooler (recommended for Next.js serverless/handlers) or Session Pooler / Direct
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Session Secret (Optional - for additional HMAC signature / rotation)
SESSION_SECRET=replace_with_a_secure_random_64_byte_hex_secret

# Application Environment
NODE_ENV=development


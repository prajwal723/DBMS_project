# ─────────────────────────────────────────────────────────────
# 1tapfix Frontend — .gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/unplugged/

# Next.js Build & Output
.next/
out/
build/
dist/
.turbo/

# Environment Variables & Secrets
.env
.env.*
*.env
!**/.env.example
!**/.env.template

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# IDE & Editor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sw?
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
._*

# Temporary & Cache
.cache/
*.tmp
*.temp
.eslintcache
.stylelintcache
*.tsbuildinfo

# Vercel Deployment
.vercel/
